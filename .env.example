# TripMate AI — environment template. Copy to `.env` and fill in real values.
# Only GROQ_API_KEY and DATABASE_URL are required; the rest degrade gracefully.

# --- Required ---------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Recommended (live tools) ----------------------------------------------
TAVILY_API_KEY=your_tavily_api_key
AVIATIONSTACK_API_KEY=your_aviationstack_api_key
OPENWEATHER_API_KEY=your_openweather_api_key

# --- Optional ---------------------------------------------------------------
# Default departure airport (IATA code), e.g. DAC
DEFAULT_ORIGIN_IATA=

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tripmate-ai
